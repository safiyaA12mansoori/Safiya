# Copy this file to .env and replace every placeholder.
# .env is gitignored. Never commit real passwords or JWT secrets.
# Phase 1 does not connect to a database. These values stay on this machine.

PORT=3000

# At least 24 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server rejects the sample value below and will not start without a real secret.
JWT_SECRET=replace-with-a-long-random-string

# Local development only. Leave this unset. A public or production server ignores it.
# ALLOW_SAMPLE_LOGIN=true

# How long a sign-in lasts. Examples: 8h, 12h, 1d
JWT_EXPIRES_IN=8h

# Optional. Production default is 12. Do not lower this on a real shop PC.
# BCRYPT_ROUNDS=12

# Used only by: npm run seed
# Creates the first Super Admin in the temporary JSON user file.
SUPER_ADMIN_NAME=Shop Owner
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-password

# Optional. Default is Backend/data/users.json (gitignored).
# DATA_FILE=Backend/data/users.json
