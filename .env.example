# Copy to .env and adjust. Never commit .env.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# XAMPP MySQL on a local machine is usually root with an empty password on port 3306.
# Create the database first: CREATE DATABASE smart_college CHARACTER SET utf8mb4;
MYSQL_DATABASE=smart_college
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# AI. Leave AI_API_KEY empty to use the labeled demo generator.
# AI_PROVIDER: demo | openai | custom | gemini
AI_PROVIDER=demo
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.0-flash

# Password reset links print in the runserver terminal with the console backend.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=erp@localhost
