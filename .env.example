# Local development only. Copy to .env. Do not use these values on a shared server.
# Nothing here is a production hosting setup.

# Application connection. milk_app is not a superuser. The password is local-only.
DATABASE_URL=postgresql://milk_app:milk_app_local@localhost:5432/milk_epr
# Prisma migrations only. On a local cluster this is the bootstrap superuser
# created by Docker or by the local PostgreSQL install. The API must not use it.
MIGRATION_DATABASE_URL=postgresql://milk:milk@localhost:5432/milk_epr
REDIS_URL=redis://127.0.0.1:6379

API_PORT=3001
API_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
SESSION_TTL_HOURS=12

# First administrator. Set BOOTSTRAP_ADMIN_PASSWORD in .env before pnpm db:seed.
# Use at least 12 characters. Do not commit that password. The seed does not
# create companies, branches, units, or master records, and it does not reset
# an existing password. NODE_ENV=production is refused unless ALLOW_BOOTSTRAP=true.
BOOTSTRAP_TENANT_NAME=Local tenant
BOOTSTRAP_TENANT_SLUG=local
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=Local Admin
