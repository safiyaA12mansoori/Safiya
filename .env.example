# Django
DJANGO_SECRET_KEY=replace-with-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Kolkata
LOG_LEVEL=INFO

# Database — target MySQL (Docker Compose). Set USE_SQLITE=1 only for local fallback.
USE_SQLITE=0
DB_ENGINE=mysql
MYSQL_DATABASE=medicore
MYSQL_USER=medicore
MYSQL_PASSWORD=medicore
MYSQL_ROOT_PASSWORD=rootsecret
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Redis / Channels (set USE_REDIS=1 when Redis is available)
USE_REDIS=0
REDIS_URL=redis://127.0.0.1:6379/0

# JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ports (compose)
API_PORT=8000
FRONTEND_PORT=5173
REDIS_PORT=6379
