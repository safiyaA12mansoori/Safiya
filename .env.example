# Local development only. Copy to .env. Do not use these values in a shared environment.

DATABASE_URL=postgresql://milk:milk@localhost:5432/milk_epr
REDIS_URL=redis://127.0.0.1:6379

API_PORT=3001
API_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
SESSION_TTL_HOURS=12

# Dev bootstrap admin. The seed creates one tenant and this user. It does not
# create companies, branches, units, or master records. Re-running the seed
# does not reset this password.
BOOTSTRAP_TENANT_NAME=Local tenant
BOOTSTRAP_TENANT_SLUG=local
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=Local Admin
BOOTSTRAP_ADMIN_PASSWORD=local-dev-password
