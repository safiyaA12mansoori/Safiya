{
  "name": "@milk-epr/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @milk-epr/validation build && prisma generate",
    "dev": "nest start --watch",
    "prebuild": "pnpm --filter @milk-epr/validation build && prisma generate",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "pnpm --filter @milk-epr/validation build && prisma generate && tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @milk-epr/validation build && prisma generate",
    "test": "jest --config ./test/jest.config.cjs --runInBand",
    "db:migrate": "node ../../scripts/with-env.mjs prisma migrate deploy",
    "db:seed": "pnpm --filter @milk-epr/validation build && node ../../scripts/with-env.mjs tsx prisma/seed.ts"
  },
  "dependencies": {
    "@milk-epr/validation": "workspace:*",
    "@nestjs/common": "11.2.9",
    "@nestjs/core": "11.2.9",
    "@nestjs/platform-express": "11.2.9",
    "@nestjs/swagger": "11.4.8",
    "@prisma/client": "6.19.3",
    "argon2": "0.45.2",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.10",
    "ioredis": "5.11.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.9",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
